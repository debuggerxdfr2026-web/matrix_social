PORT=3000
PUBLIC_URL=http://localhost:3000

# Optional: configure CRAI to use an OpenAI-compatible chat endpoint.
# Leave blank to use CRAI's built-in local assistant.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# For production WebRTC across different networks, provide your own TURN server.
# STUN-only works for many networks but is not guaranteed.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
